API_TOKEN=change-me
API_HOST=0.0.0.0
API_PORT=8787

PROGRESS_INTERVAL_SEC=86400
POLL_SEC=5

INSTANCE=145
MODE=bsgs
FILE=tests/145.txt
BITS=145
THREADS=3
KFACTOR=128
STATS=10
EXTRA_ARGS=-R -q -S
AUTOMATION=1
